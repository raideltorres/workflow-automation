# Server
NODE_ENV=development
PORT=3000
# Public origin of the Angular app (OAuth redirects land here, /api is proxied)
WEB_URL=http://localhost:4200
# At least 32 random characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET=

# MongoDB. Default is the local container from `docker compose up -d`.
# Any other MongoDB works if you replace the URI; the database name is MONGODB_DB.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=workflow-automation

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# Path to the downloaded private key (.pem files are gitignored)
GITHUB_PRIVATE_KEY_PATH=./github-app.private-key.pem

# Local webhook forwarding (create a channel at https://smee.io/new)
SMEE_URL=

# Copilot (optional)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
