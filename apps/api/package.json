{
  "name": "@workflow/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "smee": "node --env-file-if-exists=.env scripts/smee.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@octokit/app": "^16.1.4",
    "@workflow/shared": "^0.1.0",
    "connect-mongo": "^6.0.0",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "mongoose": "^9.11.4",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "smee-client": "^5.0.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  }
}
